{
  "manifest_version": 2,
  "id": "shinoyukimiyako.claude-provider",
  "version": "0.1.0",
  "name": "Claude 官方 API Provider",
  "description": "用 Anthropic 官方 SDK 原生调用 Claude Messages API，支持提示缓存、思考摘要、结构化输出与拒答兜底。",
  "author": {
    "name": "ShinoyukiMiyako",
    "url": "https://github.com/ShinoyukiMiyako"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/ShinoyukiMiyako/maibot-claude-provider"
  },
  "host_application": {
    "min_version": "1.3.9",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "anthropic",
      "version_spec": ">=1.14.0,<2.0.0"
    }
  ],
  "llm_providers": [
    {
      "client_type": "claude",
      "name": "Claude Messages API",
      "description": "通过官方 anthropic SDK 调用 Claude Messages API。",
      "version": "0.1.0"
    }
  ],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
